#!/usr/bin/env bash
set -Eeuo pipefail

readonly api_url=${API_URL:-http://127.0.0.1:8001}
readonly test_user="probe$(date +%H%M%S)"
readonly test_pass=$(openssl rand -hex 8)

cleanup() {
  set +e
  set -a
  # shellcheck disable=SC1091
  source /srv/rogueserver/shared/database.env
  set +a
  docker exec \
    --env "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" \
    rogueserver-db \
    mariadb --user=root --database=pokeroguedb \
    --execute="DELETE FROM accounts WHERE username='${test_user}';" \
    >/dev/null 2>&1
}
trap cleanup EXIT

register_status=$(curl --silent --show-error --output /dev/null \
  --write-out '%{http_code}' \
  --request POST \
  --data-urlencode "username=${test_user}" \
  --data-urlencode "password=${test_pass}" \
  "${api_url}/account/register")

[[ $register_status == 200 ]]

login_response=$(curl --fail --silent --show-error \
  --request POST \
  --data-urlencode "username=${test_user}" \
  --data-urlencode "password=${test_pass}" \
  "${api_url}/account/login")

grep -Eq '"token":"[^"]+"' <<<"$login_response"

cors_origin=$(curl --silent --show-error --dump-header - --output /dev/null \
  --header 'Origin: https://game.r117.fun' \
  "${api_url}/game/titlestats" \
  | tr -d '\r' \
  | awk 'BEGIN { IGNORECASE=1 } /^Access-Control-Allow-Origin:/ { print $2 }')

[[ $cors_origin == https://game.r117.fun ]]

echo "register=ok login=ok cors=ok"

