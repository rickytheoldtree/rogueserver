#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly root_dir=/srv/rogueserver
readonly env_file="${root_dir}/shared/database.env"
readonly backup_dir="${root_dir}/backups"
readonly stamp=$(date -u +%Y%m%dT%H%M%SZ)
readonly output="${backup_dir}/pokeroguedb-${stamp}.sql.gz"
readonly temporary="${output}.tmp"

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

mkdir -p "$backup_dir"

docker exec \
  --env "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" \
  rogueserver-db \
  mariadb-dump --user=root --single-transaction --quick --routines --events \
  "$MYSQL_DATABASE" | gzip -9 > "$temporary"

gzip -t "$temporary"
mv -f "$temporary" "$output"
find "$backup_dir" -maxdepth 1 -type f -name 'pokeroguedb-*.sql.gz' -mtime +14 -delete

echo "created ${output}"

